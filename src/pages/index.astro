---
const title = 'torrent';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <title>{title}</title>
    <style>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color-scheme: dark;
        --bg: #090b10;
        --panel: #10131a;
        --panel-2: #151922;
        --line: #28303b;
        --muted: #8d96a4;
        --text: #eef2f7;
        --accent: #6aa7ff;
        --accent-2: #8bc2ff;
        --danger: #ff7272;
        --success: #58d68d;
        --shadow: 0 18px 60px rgba(0,0,0,.28);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 20% 0%, rgba(106,167,255,.08), transparent 30%),
          radial-gradient(circle at 100% 20%, rgba(139,194,255,.05), transparent 28%),
          var(--bg);
        color: var(--text);
      }
      button, input { font: inherit; }
      button { cursor: pointer; }
      .app { width: min(1180px, calc(100% - 34px)); margin: 0 auto; padding: 28px 0 56px; }
      header {
        display: flex; justify-content: space-between; align-items: flex-start; gap: 20px;
        padding: 8px 2px 24px;
      }
      .brand { display:flex; gap:12px; align-items:center; }
      .logo {
        width: 34px; height:34px; border-radius: 9px; display:grid; place-items:center;
        border:1px solid #344254; background:#161c26; box-shadow: var(--shadow);
        font-size: 17px;
      }
      h1 { margin:0; font-size: 21px; letter-spacing:.01em; font-weight: 650; }
      .sub { color: var(--muted); font-size: 13px; margin-top: 3px; }
      .status {
        display:flex; align-items:center; gap:8px; color:var(--muted); font-size:12px;
        border:1px solid var(--line); background: rgba(16,19,26,.72); padding:8px 11px; border-radius:999px;
      }
      .dot { width:7px; height:7px; border-radius:50%; background: var(--success); box-shadow:0 0 12px rgba(88,214,141,.35); }
      .dot.warn { background:#eab85b; box-shadow:none; }
      .hero {
        border:1px solid var(--line); border-radius:14px; background:linear-gradient(180deg, rgba(21,25,34,.95), rgba(16,19,26,.95));
        box-shadow: var(--shadow); padding:18px;
      }
      .entry { display:flex; gap:10px; }
      .entry input {
        flex:1; min-width:0; background:#0c0f15; color:var(--text); border:1px solid #303847;
        outline:none; border-radius:9px; padding:13px 14px; transition:.15s border;
      }
      .entry input:focus { border-color:#577eaf; }
      .primary, .secondary, .ghost, .danger {
        border-radius:9px; border:1px solid #334052; padding:11px 14px; color:var(--text);
        background:#171d27; transition:.15s transform,.15s background,.15s border-color; white-space:nowrap;
      }
      .primary { background:#234a7a; border-color:#396da5; }
      .primary:hover { background:#2a578e; }
      .secondary:hover, .ghost:hover { background:#1d2430; border-color:#415066; }
      .danger { color:#ff9b9b; border-color:#5a3030; background:#241719; }
      button:active { transform:translateY(1px); }
      .upload {
        margin-top:11px; display:flex; justify-content:space-between; gap:12px; align-items:center;
        color:var(--muted); font-size:12px;
      }
      .file-label {
        display:inline-flex; align-items:center; gap:7px; padding:8px 10px; border:1px dashed #3a4556;
        border-radius:8px; background:#0c0f15; cursor:pointer; color:#cdd4de;
      }
      .file-label input { display:none; }
      .notice {
        display:none; margin-top:12px; border:1px solid #55462d; color:#e4c888; background:#1c1810;
        border-radius:8px; padding:10px 12px; font-size:12px; line-height:1.5;
      }
      .toolbar { display:flex; justify-content:space-between; align-items:center; margin:26px 2px 10px; gap:12px; }
      .toolbar h2 { margin:0; font-size:14px; font-weight:600; color:#d9dee7; }
      .count { color:var(--muted); font-size:12px; }
      #list { display:flex; flex-direction:column; gap:11px; }
      .empty {
        border:1px dashed #2b333f; border-radius:12px; padding:44px 20px; text-align:center; color:var(--muted); font-size:13px;
      }
      .card {
        border:1px solid var(--line); background:rgba(16,19,26,.9); border-radius:12px; padding:15px 16px;
      }
      .top { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; }
      .name { font-weight:600; font-size:14px; word-break:break-word; }
      .meta { color:var(--muted); font-size:11px; margin-top:5px; }
      .actions { display:flex; gap:7px; flex-shrink:0; }
      .actions button { padding:7px 9px; border-radius:8px; font-size:11px; }
      .bar-wrap { margin:14px 0 8px; background:#0a0d12; height:7px; border-radius:99px; overflow:hidden; border:1px solid #222934; }
      .bar { height:100%; width:0; background:linear-gradient(90deg, #5f98e8, #8bc2ff); transition:width .2s linear; }
      .stats { display:grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap:12px; margin-top:10px; }
      .stat small { display:block; color:#7f8895; font-size:10px; margin-bottom:3px; text-transform:uppercase; letter-spacing:.05em; }
      .stat b { display:block; font-size:12px; font-weight:550; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .files { margin-top:13px; border-top:1px solid #232a34; padding-top:12px; display:none; }
      .files.open { display:block; }
      .file-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center; padding:8px 0; border-bottom:1px solid #1e252e; }
      .file-row:last-child { border-bottom:none; }
      .file-name { font-size:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .file-size { color:var(--muted); font-size:10px; margin-top:3px; }
      .footer { margin-top:18px; color:#727b88; font-size:11px; line-height:1.6; }
      .footer code { color:#a6b2c2; }
      .hidden { display:none !important; }
      @media (max-width: 760px) {
        .entry { flex-direction:column; }
        .upload { align-items:flex-start; flex-direction:column; }
        .top { flex-direction:column; }
        .actions { width:100%; }
        .actions button { flex:1; }
        .stats { grid-template-columns:repeat(2, minmax(0,1fr)); }
      }
    </style>\n</head>
  <body>
    <main class="app">
      <header>
        <div class="brand">
          <div class="logo">↯</div>
          <div>
            <h1>torrent</h1>
            <div class="sub">Browser torrent downloader · Astro + WebTorrent</div>
          </div>
        </div>
        <div class="status" id="storageStatus"><span class="dot warn" id="storageDot"></span><span id="storageText">Checking persistent storage…</span></div>
      </header>

      <section class="hero">
        <div class="entry">
          <input id="magnet" autocomplete="off" spellcheck="false" placeholder="Paste a magnet URI…" aria-label="Magnet URI" />
          <button class="primary" id="addMagnet">Add torrent</button>
        </div>
        <div class="upload">
          <label class="file-label">
            <span>＋ Open .torrent file</span>
            <input id="torrentFile" type="file" accept=".torrent,application/x-bittorrent" />
          </label>
          <span>Downloads are kept in browser storage and restored after reload or restart.</span>
        </div>
        <div class="notice" id="notice"></div>
      </section>

      <div class="toolbar">
        <h2>Torrents</h2>
        <span class="count" id="count">0 items</span>
      </div>

      <section id="list">
        <div class="empty" id="empty">No torrents yet. Add a magnet URI or a <code>.torrent</code> file.</div>
      </section>

      <div class="footer">
        Torrent metadata and downloaded pieces are stored in IndexedDB through a persistent WebTorrent chunk store.
        The app requests browser persistent storage so normal refreshes and system restarts retain the saved download state and partial pieces. Explicit site-data deletion or browser uninstall/reset can remove it.
      </div>
    </main>

        <script src="../scripts/torrent-client.js"></script>
  </body>
</html>
